{
  "version": "1.0",
  "server": {
    "port": 50098,
    "host": "0.0.0.0"
  },
  "providers": [
    {
      "id": "bedrock",
      "name": "AWS Bedrock",
      "enabled": true,
      "priority": 1,
      "timeoutMs": 10000,
      "models": [
        "anthropic.claude-3-5-sonnet-20241022-v2:0",
        "anthropic.claude-3-5-haiku-20241022-v1:0"
      ]
    },
    {
      "id": "anthropic",
      "name": "Anthropic Direct",
      "enabled": true,
      "priority": 2,
      "timeoutMs": 10000,
      "models": [
        "claude-3-5-sonnet-20241022",
        "claude-3-5-haiku-20241022",
        "claude-3-opus-20240229"
      ]
    },
    {
      "id": "openai",
      "name": "OpenAI Direct",
      "enabled": true,
      "priority": 3,
      "timeoutMs": 12000,
      "models": [
        "gpt-4o",
        "gpt-4o-mini",
        "o1",
        "o3-mini"
      ]
    }
  ],
  "circuitBreaker": {
    "failureThreshold": 3,
    "windowMs": 30000,
    "recoveryTimeMs": 30000,
    "halfOpenProbes": 2,
    "errorCodes": [429, 500, 502, 503, 504]
  },
  "budget": {
    "defaultDailyLimitUsd": 50.0,
    "defaultMonthlyLimitUsd": 500.0,
    "downgradeThresholdRatio": 0.8,
    "downgradeMappings": {
      "claude-3-5-sonnet-20241022": "claude-3-5-haiku-20241022",
      "anthropic.claude-3-5-sonnet-20241022-v2:0": "anthropic.claude-3-5-haiku-20241022-v1:0",
      "gpt-4o": "gpt-4o-mini",
      "claude-3-opus-20240229": "claude-3-5-haiku-20241022"
    }
  },
  "loopDetector": {
    "enabled": true,
    "windowSeconds": 60,
    "maxIdenticalCalls": 3,
    "blockAction": "TERMINATE_WITH_WARNING"
  },
  "database": {
    "path": "./data/tokencircuit.db"
  }
}
