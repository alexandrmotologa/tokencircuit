# TokenCircuit Environment Configuration

# Gateway Server
PORT=50098
HOST=0.0.0.0
NODE_ENV=development

# Database
DATABASE_PATH=./data/tokencircuit.db

# Upstream Provider API Keys
ANTHROPIC_API_KEY=sk-ant-api03-...
OPENAI_API_KEY=sk-proj-...
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1

# Circuit Breaker Defaults
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_RECOVERY_TIME_MS=30000
CIRCUIT_WINDOW_MS=30000
CIRCUIT_HALF_OPEN_PROBES=2

# Budget & Loop Controls
DEFAULT_DAILY_LIMIT_USD=50.00
DEFAULT_MONTHLY_LIMIT_USD=500.00
DOWNGRADE_THRESHOLD_RATIO=0.80
LOOP_DETECTOR_WINDOW_SECONDS=60
LOOP_DETECTOR_THRESHOLD=3

# Gateway Auth (Optional bearer token for administrative routes)
ADMIN_SECRET_KEY=
