{
  "name": "tokencircuit",
  "version": "1.0.0",
  "description": "Enterprise LLM circuit breaker and financial protection gateway with multi-provider failover, hard tenant budget caps, and agent loop termination",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "tokencircuit": "./bin/tokencircuit.js"
  },
  "type": "module",
  "scripts": {
    "build:core": "tsup",
    "build:studio": "vite build --config src/studio/vite.config.ts",
    "build": "npm run build:core && npm run build:studio",
    "dev": "tsx watch src/cli/index.ts serve",
    "dev:studio": "vite --config src/studio/vite.config.ts",
    "start": "node bin/tokencircuit.js serve",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "llm-gateway",
    "circuit-breaker",
    "cost-control",
    "failover",
    "anthropic-api",
    "openai-api",
    "bedrock",
    "resilience",
    "agent-guard",
    "fastify",
    "typescript",
    "react19"
  ],
  "author": "Alexandr Motologa",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^8.1.1",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "ora": "^8.2.0",
    "picocolors": "^1.1.1",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.475.0",
    "puppeteer": "^24.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "tsup": "^8.3.6",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
